<Window x:Class="Fokus.UI.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:Fokus.UI.Controls"
        mc:Ignorable="d"
        Title="Fokus"
        Width="380"
        Height="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Deactivated="Window_Deactivated"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">
    <Window.Resources>
        <!-- Subtle Windows 11 Flyout Shadow -->
        <DropShadowEffect x:Key="FlyoutShadow" BlurRadius="36" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.55"/>

        <!-- Segmented Control RadioButton Style -->
        <Style x:Key="SegmentedRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" CornerRadius="12" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#25FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container with Windows 11 Acrylic Backdrop & ClearType Enabled -->
    <Border Margin="14" CornerRadius="16" Effect="{StaticResource FlyoutShadow}"
            Background="#F0202020"
            BorderBrush="#2AFFFFFF" BorderThickness="1"
            RenderOptions.ClearTypeHint="Enabled"
            TextOptions.TextFormattingMode="Display"
            TextOptions.TextRenderingMode="ClearType"
            TextOptions.TextHintingMode="Fixed"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content Tabs -->
                <RowDefinition Height="Auto"/> <!-- Bottom Tab Navigation -->
            </Grid.RowDefinitions>

            <!-- Top Header -->
            <Border Grid.Row="0" Padding="16,12,16,12" BorderBrush="#1FFFFFFF" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Title / Icon -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Clock24" FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="FOKUS" FontFamily="Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI"
                                   FontWeight="Bold" FontSize="14"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Mode Selector: Pomodoro / Flowmodoro -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" Background="#14FFFFFF"
                            CornerRadius="14" Padding="3" BorderBrush="#18FFFFFF" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbPomodoro" Content="Pomodoro" IsChecked="True"
                                         GroupName="ModeGroup" Checked="RbMode_Changed"
                                         Style="{StaticResource SegmentedRadioButtonStyle}" Padding="10,4" FontSize="11" Margin="0,0,2,0"/>
                            <RadioButton x:Name="RbFlowmodoro" Content="Flowmodoro"
                                         GroupName="ModeGroup" Checked="RbMode_Changed"
                                         Style="{StaticResource SegmentedRadioButtonStyle}" Padding="10,4" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- Quick Close / Pin -->
                    <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Dismiss16}" Appearance="Transparent"
                               Width="30" Height="30" CornerRadius="15" Padding="0" Click="BtnClose_Click"
                               ToolTip="Ocultar a la bandeja"/>
                </Grid>
            </Border>

            <!-- Main Content Panels -->
            <Grid Grid.Row="1">
                <!-- 1. TAB: TIMER -->
                <Grid x:Name="TabTimerView" Visibility="Visible">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel VerticalAlignment="Center" Margin="16,10,16,10">
                            <!-- Presets Pills Row (visible in Pomodoro) -->
                            <StackPanel x:Name="PresetsRow" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <ui:Button x:Name="BtnPreset1" Content="25 / 5" Appearance="Secondary" FontSize="11" FontWeight="Medium" CornerRadius="12" Padding="12,4" Click="BtnPreset_Click" Margin="0,0,8,0"/>
                                <ui:Button x:Name="BtnPreset2" Content="50 / 10" Appearance="Secondary" FontSize="11" FontWeight="Medium" CornerRadius="12" Padding="12,4" Click="BtnPreset_Click" Margin="0,0,8,0"/>
                                <ui:Button x:Name="BtnPreset3" Content="90 / 20" Appearance="Secondary" FontSize="11" FontWeight="Medium" CornerRadius="12" Padding="12,4" Click="BtnPreset_Click"/>
                            </StackPanel>

                            <!-- Central Dial -->
                            <controls:TimerDial x:Name="MainDial"/>

                            <!-- Active Task Selector Chip -->
                            <Border Background="#12FFFFFF"
                                    CornerRadius="12" Padding="12,9" Margin="0,14,0,0"
                                    BorderBrush="#1AFFFFFF" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ui:SymbolIcon Grid.Column="0" Symbol="TasklistSquareLtr20" FontSize="16" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>

                                    <TextBlock Grid.Column="1" x:Name="TxtActiveTaskBar" Text="Sin tarea asignada"
                                               FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                    <ui:Button Grid.Column="2" Content="Cambiar" Appearance="Transparent"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               FontSize="11" FontWeight="SemiBold" Padding="8,2" Click="BtnSwitchToTasks_Click"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 2. TAB: TASKS (TO-DO LIST) -->
                <Grid x:Name="TabTasksView" Visibility="Collapsed" Margin="16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Add Task Input -->
                        <RowDefinition Height="*"/>    <!-- Task List -->
                        <RowDefinition Height="Auto"/> <!-- Footer Actions -->
                    </Grid.RowDefinitions>

                    <!-- Add Task Box -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ui:TextBox Grid.Column="0" x:Name="TxtNewTask" PlaceholderText="Nueva tarea pendiente..."
                                    KeyDown="TxtNewTask_KeyDown" Margin="0,0,6,0"/>
                        <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Add20}" Appearance="Primary" Click="BtnAddTask_Click"/>
                    </Grid>

                    <!-- Tasks List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TaskListContainer"/>
                    </ScrollViewer>

                    <!-- Tasks Footer (Clear done & archived count) -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" x:Name="TxtOpenTasksCount" Text="0 tareas pendientes"
                                   FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>

                        <ui:Button Grid.Column="1" Content="Limpiar completadas" Appearance="Secondary"
                                   FontSize="11" Click="BtnClearDone_Click"/>
                    </Grid>
                </Grid>

                <!-- 3. TAB: STATS -->
                <Grid x:Name="TabStatsView" Visibility="Collapsed" Margin="16,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Period Selector (Hoy, 7d, 14d, 30d) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <ui:Button x:Name="BtnPeriodToday" Content="Hoy" Appearance="Primary" FontSize="11" Padding="12,4" Click="BtnPeriod_Click" Margin="0,0,6,0"/>
                                <ui:Button x:Name="BtnPeriod7" Content="7 días" Appearance="Secondary" FontSize="11" Padding="12,4" Click="BtnPeriod_Click" Margin="0,0,6,0"/>
                                <ui:Button x:Name="BtnPeriod14" Content="14 días" Appearance="Secondary" FontSize="11" Padding="12,4" Click="BtnPeriod_Click" Margin="0,0,6,0"/>
                                <ui:Button x:Name="BtnPeriod30" Content="30 días" Appearance="Secondary" FontSize="11" Padding="12,4" Click="BtnPeriod_Click"/>
                            </StackPanel>

                            <!-- Today Clock Ring (Visible when 'Hoy' selected) -->
                            <controls:DayClockRing x:Name="ClockRing" HorizontalAlignment="Center"/>

                            <!-- Stacked Bar Chart (Visible when > 1 days selected) -->
                            <controls:StackedBarChart x:Name="StackedChart" Visibility="Collapsed" Margin="0,6"/>

                            <!-- Summary Metrics Cards -->
                            <UniformGrid Columns="3" Margin="0,8,0,8">
                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="8,6" Margin="2">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="ENFOQUE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtMetricFocus" Text="0m" FontSize="14" FontWeight="SemiBold" Foreground="#EB4B55" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="8,6" Margin="2">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="DESCANSOS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtMetricBreak" Text="0m" FontSize="14" FontWeight="SemiBold" Foreground="#2EB38F" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="8,6" Margin="2">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="INACTIVO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtMetricIdle" Text="0m" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Task Breakdown Legend -->
                            <StackPanel x:Name="TasksLegendContainer" Margin="0,4"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 4. TAB: SETTINGS -->
                <Grid x:Name="TabSettingsView" Visibility="Collapsed" Margin="16,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Duraciones -->
                            <TextBlock Text="Temporizador" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="14,10"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Tiempo de concentración (min):" VerticalAlignment="Center" FontSize="12"/>
                                        <TextBox x:Name="TbFocusTime" Grid.Column="1" Width="55" Text="25" TextAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Descanso corto (min):" VerticalAlignment="Center" FontSize="12"/>
                                        <TextBox x:Name="TbShortBreakTime" Grid.Column="1" Width="55" Text="5" TextAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Descanso largo (min):" VerticalAlignment="Center" FontSize="12"/>
                                        <TextBox x:Name="TbLongBreakTime" Grid.Column="1" Width="55" Text="20" TextAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Sesiones antes de descanso largo:" VerticalAlignment="Center" FontSize="12"/>
                                        <TextBox x:Name="TbSessionsCount" Grid.Column="1" Width="55" Text="4" TextAlignment="Center"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Divisor de Flowmodoro (1/N):" VerticalAlignment="Center" FontSize="12"/>
                                        <TextBox x:Name="TbFlowDivisor" Grid.Column="1" Width="55" Text="5" TextAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Overlay de descanso a pantalla completa -->
                            <TextBlock Text="Overlay de Descanso" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="14,10"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,14">
                                <StackPanel>
                                    <ui:ToggleSwitch x:Name="SwFullscreenBreak" Content="Mostrar overlay a pantalla completa" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Opacidad del fondo (%):" VerticalAlignment="Center" FontSize="12"/>
                                        <TextBox x:Name="TbOverlayOpacity" Grid.Column="1" Width="55" Text="65" TextAlignment="Center"/>
                                    </Grid>
                                    <ui:ToggleSwitch x:Name="SwButtonsOnHover" Content="Mostrar botones solo al pasar el cursor"/>
                                </StackPanel>
                            </Border>

                            <!-- Audio & Notificaciones -->
                            <TextBlock Text="Sonidos y Notificaciones" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="14,10"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,14">
                                <StackPanel>
                                    <ui:ToggleSwitch x:Name="SwNotifyTimerEnd" Content="Notificar al finalizar concentración" Margin="0,0,0,8"/>
                                    <ui:ToggleSwitch x:Name="SwNotifyBreakEnd" Content="Notificar al finalizar descanso" Margin="0,0,0,8"/>
                                    <ui:ToggleSwitch x:Name="SwSoundTimerEnd" Content="Sonido al finalizar concentración" Margin="0,0,0,8"/>
                                    <ui:ToggleSwitch x:Name="SwSoundBreakEnd" Content="Sonido al finalizar descanso" Margin="0,0,0,8"/>
                                    <ui:ToggleSwitch x:Name="SwTicking" Content="Sonido tic-tac en recta final" Margin="0,0,0,8"/>
                                    <ui:ToggleSwitch x:Name="SwPauseMedia" Content="Pausar reproductores multimedia al descansar"/>
                                </StackPanel>
                            </Border>

                            <!-- Apariencia y Sistema -->
                            <TextBlock Text="Apariencia y Sistema" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,6"/>
                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="10" Padding="14,10"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Estilo icono del Tray:" VerticalAlignment="Center" FontSize="12"/>
                                        <ComboBox x:Name="CbTrayStyle" Grid.Column="1" Width="120" SelectedIndex="0">
                                            <ComboBoxItem Content="Tomate"/>
                                            <ComboBoxItem Content="Anillo"/>
                                            <ComboBoxItem Content="Cuña"/>
                                        </ComboBox>
                                    </Grid>
                                    <ui:ToggleSwitch x:Name="SwAutostart" Content="Iniciar Fokus con Windows" Margin="0,0,0,8"/>
                                    <ui:ToggleSwitch x:Name="SwScrollAdjust" Content="Scroll sobre el icono ajusta minutos" Margin="0,0,0,8"/>
                                    <ui:ToggleSwitch x:Name="SwFlashOnEnd" Content="Parpadeo visual al finalizar sesión"/>
                                </StackPanel>
                            </Border>

                            <ui:Button Content="Guardar Configuración" Appearance="Primary" HorizontalAlignment="Stretch" Margin="0,4,0,10" Click="BtnSaveSettings_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Bottom Navigation Bar -->
            <Border Grid.Row="2" Padding="10,6" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0">
                <UniformGrid Columns="4">
                    <ui:Button x:Name="NavBtnTimer" Appearance="Secondary" Click="NavBtn_Click" Margin="2" Padding="2,6" CornerRadius="8" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Clock24" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Tiempo" FontSize="10" FontWeight="Medium" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                    <ui:Button x:Name="NavBtnTasks" Appearance="Transparent" Click="NavBtn_Click" Margin="2" Padding="2,6" CornerRadius="8" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="TasklistSquareLtr24" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Tareas" FontSize="10" FontWeight="Medium" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                    <ui:Button x:Name="NavBtnStats" Appearance="Transparent" Click="NavBtn_Click" Margin="2" Padding="2,6" CornerRadius="8" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="DataBarVertical24" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Métricas" FontSize="10" FontWeight="Medium" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                    <ui:Button x:Name="NavBtnSettings" Appearance="Transparent" Click="NavBtn_Click" Margin="2" Padding="4,6" CornerRadius="8" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBlock Text="Ajustes" FontSize="10" FontWeight="Medium" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>
                </UniformGrid>
            </Border>
        </Grid>
    </Border>
</Window>
